# ============================================================
# Echoed — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your real values:
#   cp .env.example .env.local
#
# NEVER commit .env.local — it is listed in .gitignore
# ============================================================

# --- Database (Amazon RDS PostgreSQL with pgvector) ---
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_RDS_ENDPOINT:5432/echoed

# --- Amazon Cognito Authentication ---
COGNITO_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_CLIENT_ID=your-app-client-id
COGNITO_CLIENT_SECRET=your-app-client-secret
NEXT_PUBLIC_COGNITO_REGION=ap-southeast-2

# --- Meta LLM Verification (Meta Muse Spark Open via Baseten) ---
META_LLM_API_URL=https://inference.baseten.co/v1/chat/completions
META_LLM_API_KEY=your-baseten-api-key
META_LLM_MODEL=meta-models/muse-spark-open-1026
